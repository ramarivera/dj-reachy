# Load these explicitly in your process environment or user-owned app .env.
# The app never overwrites a legacy packaged .env.
# Leave keys empty unless that provider is intentionally selected/configured.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Nonsecret settings belong in settings.json under DJ_REACHY_REMIX_HOME.
# Otherwise storage defaults to $XDG_DATA_HOME/dj-reachy-remix or ~/.local/share/dj-reachy-remix.
# DJ_REACHY_REMIX_HOME=/absolute/user-owned/path
DJ_REACHY_REMIX_UI_HOST=127.0.0.1
DJ_REACHY_REMIX_UI_PORT=7860

# Subscription Live is the default backend. Broker configuration stays environment-only.
# The voice implementation owns broker/credential-source setup and entitlement checks.
DJ_REACHY_REMIX_SUBSCRIPTION_BROKER_URL=
DJ_REACHY_REMIX_SUBSCRIPTION_BROKER_TOKEN=

# Optional local vision cache. Set to a user-owned directory.
# HF_HOME=/absolute/user-owned/cache
# HF_TOKEN=
